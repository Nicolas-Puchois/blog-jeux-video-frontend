<!DOCTYPE html>
<html lang="fr" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <link
      rel="stylesheet"
      href="<%= process.env.SITE_URL %>/assets/styles/styles.css"
    />
    <% if(title == "Accueil"){ %>
    <link
      rel="stylesheet"
      href="<%= process.env.SITE_URL %>/assets/styles/home/home.css"
    />
    <% } %> <% if(title == "Articles"){ %>
    <link
      rel="stylesheet"
      href="<%= process.env.SITE_URL %>/assets/styles/articles/articles.css"
    />
    <% } %> <% if(title == "S'inscrire" || title == "Se Connecter"){ %>
    <link
      rel="stylesheet"
      href="<%= process.env.SITE_URL %>/assets/styles/form/form.css"
    />
    <% } %> <% if(title == "Valider votre Email"){ %>
    <link
      rel="stylesheet"
      href="<%= process.env.SITE_URL %>/assets/styles/validateEmail/validateEmail.css"
    />
    <% } %> <% if(title == "Créer un article"){ %>
    <link
      rel="stylesheet"
      href="<%= process.env.SITE_URL %>/assets/styles/createArticles/createArticle.css"
    />
    <% } %>

    <title><%= title || "InfoD0tGame" %></title>
  </head>

  <body>
    <header><%-include("./components/header") %></header>
    <main><%- include(view)%></main>
    <footer><%-include("./components/footer") %></footer>
  </body>
  <% if(title == "S'inscrire"){ %>
  <script
    type="module"
    src="<%= process.env.SITE_URL %>/assets/js/register.js"
  ></script>
  <% } %> <% if(title == "Valider votre Email"){ %>
  <script
    type="module"
    src="<%= process.env.SITE_URL %>/assets/js/validateEmail.js"
  ></script>
  <% } %> <% if(title == "Se Connecter"){ %>
  <script
    type="module"
    src="<%= process.env.SITE_URL %>/assets/js/login.js"
  ></script>
  <% } %>
  <script
    type="module"
    src="<%= process.env.SITE_URL %>/services/notification.js"
  ></script>
  <script
    type="module"
    src="<%= process.env.SITE_URL %>/assets/js/role.js"
  ></script>
  <% if(title == "Créer un article"){ %>
  <script
    type="module"
    src="<%= process.env.SITE_URL %>/assets/js/createArticle.js"
  ></script>
  <% } %> <% if (title == "Articles"){ %>
  <script src="/assets/js/getAllArticle.js"></script>
  <% } %>
</html>
