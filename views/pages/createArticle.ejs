<section class="create-article-container">
  <!-- Modifié ici : ajout de la classe form-title -->
  <h1 class="form-title">Créer un article</h1>

  <form
    id="article-form"
    class="article-form"
    method="POST"
    enctype="multipart/form-data"
  >
    <input type="hidden" id="api-url" value="<%= process.env.API_URL %>" />
    <input
      type="hidden"
      id="api-img-url"
      value="<%= process.env.API_IMG_URL %>"
    />

    <div class="form-group">
      <label for="title">Titre de l'article</label>
      <input
        type="text"
        id="title"
        name="title"
        placeholder="Entrez le titre de votre article"
      />
      <span class="error" data-error="title"></span>
    </div>

    <div class="form-group">
      <label for="tags">Tags (séparés par des virgules)</label>
      <input
        type="text"
        id="tags"
        name="tags"
        placeholder="gaming, tech, optimisation, ..."
      />
      <span class="error" data-error="tags"></span>
    </div>

    <div class="form-group">
      <label for="image">Image principale</label>
      <div class="image-upload-container">
        <input
          type="file"
          id="image"
          name="image"
          accept="image/jpeg,image/png,image/webp"
        />
        <img
          id="preview-image"
          alt="Prévisualisation"
          style="display: none; max-width: 100%; margin-top: 1rem"
        />
      </div>
      <span class="error" data-error="image"></span>
    </div>

    <div class="form-group">
      <label for="introduction">Introduction</label>
      <textarea
        id="introduction"
        name="introduction"
        rows="3"
        placeholder="Écrivez une brève introduction de votre article..."
      ></textarea>
      <span class="error" data-error="introduction"></span>
    </div>

    <div class="form-group">
      <label for="content">Contenu de l'article</label>
      <textarea
        id="content"
        name="content"
        rows="15"
        placeholder="Rédigez votre article ici..."
      ></textarea>
      <span class="error" data-error="content"></span>
    </div>

    <div class="form-actions">
      <!-- Bouton de création - visible uniquement en mode création -->
      <button type="submit" class="btn-submit btn-create" id="create-button">
        Publier l'article
      </button>

      <!-- Bouton de modification - visible uniquement en mode édition -->
      <button
        type="submit"
        class="btn-submit btn-update"
        id="update-button"
        style="display: none"
      >
        Mettre à jour l'article
      </button>
    </div>

    <div id="form-message" class="form-message"></div>
  </form>
</section>
