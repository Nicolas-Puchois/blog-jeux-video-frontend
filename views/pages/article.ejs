<input type="hidden" id="api-url" value="<%= process.env.API_URL %>" />
<input type="hidden" id="api-img-url" value="<%= process.env.API_IMG_URL %>" />
<input type="hidden" name="csrf_token" value="<%= process.env.CSRF_TOKEN %>" />

<article class="article-page" itemscope itemtype="http://schema.org/Article">
  <div class="article-hero">
    <figure class="article-image">
      <img id="article-cover-image" src="" alt="" itemprop="image" />
    </figure>
  </div>

  <div class="article-content">
    <header class="article-header">
      <h1 id="article-title" itemprop="headline"></h1>

      <div class="article-metadata">
        <time id="article-date" itemprop="datePublished" datetime=""></time>
        <div
          class="article-author"
          itemprop="author"
          itemscope
          itemtype="http://schema.org/Person"
        >
          <span class="author-name" itemprop="name"></span>
        </div>
        <div id="article-tags" class="article-tags"></div>
      </div>
    </header>

    <div id="article-intro" class="article-introduction" itemprop="description">
      <!-- L'introduction sera chargée ici -->
    </div>

    <div id="article-content" class="article-body" itemprop="articleBody">
      <!-- Le contenu sera chargé ici -->
    </div>

    <div class="article-actions" style="display: none">
      <button class="btn btn-edit">
        <i class="fas fa-edit"></i>
        Modifier l'article
      </button>
      <button class="btn btn-delete">
        <i class="fas fa-trash-alt"></i>
        Supprimer l'article
      </button>
    </div>
  </div>

  <section class="comments-section">
    <header class="comments-header">
      <h2>Commentaires</h2>
      <span class="comment-count">0 commentaires</span>
    </header>

    <div class="comment-form">
      <div class="user-avatar"></div>
      <form class="add-comment-form">
        <textarea placeholder="Ajouter un commentaire..." required></textarea>
        <div class="form-actions">
          <button type="submit" class="btn-submit">Publier</button>
        </div>
      </form>
    </div>

    <div id="comments-list" class="comments-list">
      <!-- Les commentaires seront chargés dynamiquement ici -->
    </div>

    <button
      id="load-more-comments"
      class="load-more-comments"
      style="display: none"
    >
      Charger plus de commentaires
    </button>
  </section>
</article>
