<section class="form-container">
  <h1>S'enregistrer</h1>

  <form id="register-form" method="POST" action="" class="form">
    <input
      type="hidden"
      name="csrf_token"
      value="<%= process.env.CSRF_TOKEN %>"
    />
    <input
      type="hidden"
      id="api-url"
      value="<%= typeof API_URL !== 'undefined' ? API_URL : '' %>"
    />

    <div class="form-group">
      <label for="username">Nom d'utilisateur</label>
      <input type="text" class="form-control" id="username" name="username" />
      <span class="error" data-error="username"></span>
    </div>

    <div class="form-group">
      <label for="email">Adresse email</label>
      <input
        type="text"
        class="form-control"
        id="email"
        autocomplete="username"
        name="email"
      />
      <span class="error" data-error="email"></span>
    </div>

    <div class="form-group">
      <label for="password">Mot de passe</label>
      <input
        type="password"
        class="form-control"
        id="password"
        name="password"
        autocomplete="current-password"
      />
      <span class="error" data-error="password"></span>
    </div>

    <div class="form-group">
      <label for="repeat-password"> Répéter le mot de passe</label>
      <input
        type="password"
        class="form-control"
        id="repeat-password"
        name="repeat-password"
        autocomplete="current-password"
      />
      <span class="error" data-error="repeat-password"></span>
    </div>
    <div id="verify-msg"></div>
    <button
      type="submit"
      class="g-recaptcha btn"
      data-sitekey="<%= RECAPTCHA_PUBLIC_KEY %>"
      data-callback="onRecaptchaSubmit"
      data-action="login"
    >
      S'enregistrer
    </button>
  </form>
</section>
