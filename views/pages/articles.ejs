<input
  type="hidden"
  id="api-url"
  value="<%= typeof API_URL !== 'undefined' ? API_URL : '' %>"
/>
<input
  type="hidden"
  id="api-img-url"
  value="<%= typeof API_IMG_URL !== 'undefined' ? API_IMG_URL : '' %>"
/>
<div class="articles-container">
  <section class="articles-header">
    <h1>Les articles</h1>
    <a href="/create-article" class="create-article-btn user-role author-only"
      >Créer un article</a
    >
  </section>

  <section class="articles-filter">
    <h2>Filtre</h2>
    <div class="filter-options">
      <div class="filter-group">
        <label>Date de parution</label>
        <input type="date" class="filter-date" value="2025/05/20" />
      </div>
      <div class="filter-group">
        <label>Auteur</label>
        <input type="text" class="filter-author" placeholder="John Doe" />
      </div>
      <div class="filter-group">
        <label>Tags</label>
        <input
          type="text"
          class="filter-tags"
          placeholder="esport, publicité, ..."
        />
      </div>
    </div>
  </section>

  <div class="articles-list">
    <!-- Les articles seront chargés dynamiquement ici -->
  </div>

  <div class="articles-pagination">
    <button class="voir-plus">Voir plus d'articles ...</button>
  </div>
</div>
