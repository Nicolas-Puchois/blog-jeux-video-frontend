<input
  type="hidden"
  id="api-url"
  value="<%= typeof API_URL !== 'undefined' ? API_URL : '' %>"
/>
<input
  type="hidden"
  id="api-img-url"
  value="<%= typeof API_IMG_URL !== 'undefined' ? API_IMG_URL : '' %>"
/>
<main class="articles-page">
  <section class="articles-header">
    <h1>Articles & Actualités Gaming</h1>
    <meta
      name="description"
      content="Explorez notre collection d'articles sur les jeux vidéo, eSport, tests et actualités gaming."
    />
  </section>

  <div class="articles-container">
    <aside class="articles-filter">
      <a
        href="/create-article"
        class="create-article-btn user-role author-only"
        rel="nofollow"
        >Créer un article</a
      >

      <section class="filter-container">
        <h2>Filtres de recherche</h2>
        <form class="filter-form" role="search">
          <div class="filter-group">
            <label for="date-filter">Date de publication</label>
            <input
              type="date"
              id="date-filter"
              name="date"
              aria-label="Filtrer par date"
            />
          </div>

          <div class="filter-group">
            <label for="author-filter">Auteur</label>
            <input
              type="text"
              id="author-filter"
              name="author"
              aria-label="Filtrer par auteur"
            />
          </div>

          <div class="filter-group">
            <label for="tags-filter">Tags</label>
            <input
              type="text"
              id="tags-filter"
              name="tags"
              aria-label="Filtrer par tags"
            />
          </div>
        </form>
      </section>
    </aside>

    <section class="articles-list" aria-label="Liste des articles">
      <!-- Articles générés dynamiquement -->
    </section>
  </div>
</main>
