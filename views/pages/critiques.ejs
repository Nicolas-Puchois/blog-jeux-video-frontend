<main class="critiques-page">
  <div class="critiques-container">
    <section class="critiques-header">
      <h1>Les critiques</h1>
    </section>

    <section class="critiques-list">
      <!-- Carte 1 -->
      <article class="critique-card">
        <div class="critique-image">
          <img src="/assets/images/placeholder.jpg" alt="Image du jeu" />
        </div>
        <div class="score-circle">
          <div class="score-value">95</div>
          <div class="score-max">/100</div>
        </div>
        <div class="critique-content">
          <h3>Baldur's Gate 3</h3>
          <p class="game-title">Le retour du roi du RPG</p>
          <p class="critique-preview">
            Un jeu de rôle épique qui redéfinit les standards du genre...
          </p>
          <a href="#" class="read-more">Voir le test complet</a>
        </div>
      </article>

      <!-- Carte 2 -->
      <article class="critique-card">
        <div class="critique-image">
          <img src="/assets/images/placeholder.jpg" alt="Image du jeu" />
        </div>
        <div class="score-circle">
          <div class="score-value">88</div>
          <div class="score-max">/100</div>
        </div>
        <div class="critique-content">
          <h3>Starfield</h3>
          <p class="game-title">L'aventure spatiale de Bethesda</p>
          <p class="critique-preview">
            Une exploration spatiale ambitieuse mais avec quelques
            turbulences...
          </p>
          <a href="#" class="read-more">Voir le test complet</a>
        </div>
      </article>

      <!-- Carte 3 -->
      <article class="critique-card">
        <div class="critique-image">
          <img src="/assets/images/placeholder.jpg" alt="Image du jeu" />
        </div>
        <div class="score-circle">
          <div class="score-value">92</div>
          <div class="score-max">/100</div>
        </div>
        <div class="critique-content">
          <h3>Street Fighter 6</h3>
          <p class="game-title">Le combat nouvelle génération</p>
          <p class="critique-preview">
            Un retour fracassant pour la série avec des innovations
            bienvenues...
          </p>
          <a href="#" class="read-more">Voir le test complet</a>
        </div>
      </article>

      <!-- Carte 4 -->
      <article class="critique-card">
        <div class="critique-image">
          <img src="/assets/images/placeholder.jpg" alt="Image du jeu" />
        </div>
        <div class="score-circle">
          <div class="score-value">60</div>
          <div class="score-max">/100</div>
        </div>
        <div class="critique-content">
          <h3>Resident Evil 4 Remake</h3>
          <p class="game-title">Le classique réinventé</p>
          <p class="critique-preview">
            Une réinvention magistrale d'un chef-d'œuvre du survival horror...
          </p>
          <a href="#" class="read-more">Voir le test complet</a>
        </div>
      </article>
    </section>

    <aside class="critiques-filter">
      <a href="/create-critique" class="create-critique-btn"
        >Créer une critique</a
      >

      <section class="filter-container">
        <h2>Filtres de recherche</h2>
        <form class="filter-form" role="search">
          <div class="filter-group">
            <label for="date-filter">Date de publication</label>
            <input
              type="date"
              id="date-filter"
              name="date"
              aria-label="Filtrer par date"
            />
          </div>

          <div class="filter-group">
            <label for="author-filter">Auteur</label>
            <input
              type="text"
              id="author-filter"
              name="author"
              aria-label="Filtrer par auteur"
            />
          </div>

          <div class="filter-group">
            <label for="tags-filter">Tags</label>
            <input
              type="text"
              id="tags-filter"
              name="tags"
              aria-label="Filtrer par tags"
            />
          </div>
        </form>
      </section>
    </aside>
  </div>

  <div class="critiques-pagination">
    <button class="voir-plus">Voir plus de critiques ...</button>
  </div>
</main>
